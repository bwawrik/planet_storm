; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="GAME TEMPLATE"
run/main_scene="uid://cfv66tflmxx52"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://ylxragrbejpq"
config/icon="res://icon.svg"

[autoload]

SharedData="*res://SCENES/SharedData/SharedData.tscn"
SceneManager="*res://SCENES/SCENEMANAGER/SceneManager.tscn"
SignalBus="*res://SCENES/SignalBus/SignalBus.tscn"
AchiementBus="res://SCENES/AchievementBus/AchiementBus.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/aspect="keep_height"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=2

[dotnet]

project/assembly_name="GAME TEMPLATE"

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
"res://FONTS/": "purple",
"res://IMAGES/": "yellow",
"res://RESOURCES/": "green",
"res://SCENES/": "red",
"res://SCRIPTS/": "orange",
"res://SOUND/": "teal",
"res://TEMPLATES/": "pink"
}

